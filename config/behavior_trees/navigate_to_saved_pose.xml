<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <CaptureTravelGoal goal="{goal}" travel_goal="{travel_goal}"/>
      <ReplanUntilClear final_stage="false">
        <ComputePathToPose goal="{travel_goal}" path="{path}" planner_id="GridBased"/>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
      </ReplanUntilClear>
      <ReplanUntilClear>
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
      </ReplanUntilClear>
    </Sequence>
  </BehaviorTree>
</root>
