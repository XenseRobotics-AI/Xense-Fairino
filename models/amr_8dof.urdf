<?xml version="1.0"?>
<robot name="amr_8dof_chassis">
  <!-- +X forward, +Y left, +Z up; base_link is at wheel-axle height. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>
  <link name="base_link">
    <visual><origin xyz="0 0 0.065" rpy="0 0 0"/><geometry><box size="0.750 0.600 0.130"/></geometry></visual>
    <collision><origin xyz="0 0 0.065" rpy="0 0 0"/><geometry><box size="0.750 0.600 0.130"/></geometry></collision>
  </link>

  <!-- front_right: steering-axis position in base_link; drive offset a = 0. -->
  <link name="front_right_steering_link"/>
  <joint name="j1" type="continuous">
    <parent link="base_link"/><child link="front_right_steering_link"/>
    <origin xyz="0.310 -0.225 0.000" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <link name="front_right_wheel_link">
    <visual><origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.065" length="0.030"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.065" length="0.030"/></geometry></collision>
  </link>
  <joint name="j2" type="continuous">
    <parent link="front_right_steering_link"/><child link="front_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <!-- rear_right: steering-axis position in base_link; drive offset a = 0. -->
  <link name="rear_right_steering_link"/>
  <joint name="j3" type="continuous">
    <parent link="base_link"/><child link="rear_right_steering_link"/>
    <origin xyz="-0.305 -0.2175 0.000" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <link name="rear_right_wheel_link">
    <visual><origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.065" length="0.030"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.065" length="0.030"/></geometry></collision>
  </link>
  <joint name="j4" type="continuous">
    <parent link="rear_right_steering_link"/><child link="rear_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <!-- front_left: steering-axis position in base_link; drive offset a = 0. -->
  <link name="front_left_steering_link"/>
  <joint name="j5" type="continuous">
    <parent link="base_link"/><child link="front_left_steering_link"/>
    <origin xyz="0.310 0.225 0.000" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <link name="front_left_wheel_link">
    <visual><origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.065" length="0.030"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.065" length="0.030"/></geometry></collision>
  </link>
  <joint name="j6" type="continuous">
    <parent link="front_left_steering_link"/><child link="front_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <!-- rear_left: steering-axis position in base_link; drive offset a = 0. -->
  <link name="rear_left_steering_link"/>
  <joint name="j7" type="continuous">
    <parent link="base_link"/><child link="rear_left_steering_link"/>
    <origin xyz="-0.305 0.2175 0.000" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <link name="rear_left_wheel_link">
    <visual><origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.065" length="0.030"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.065" length="0.030"/></geometry></collision>
  </link>
  <joint name="j8" type="continuous">
    <parent link="rear_left_steering_link"/><child link="rear_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <!-- Sensors: user-specified lidar extrinsics in the runtime base_link frame, 2026-10-19. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0.085 0.000 0.250" rpy="0 0 0"/>
  </joint>
  <!-- User-specified front lidar pose relative to base_link -->
  <link name="front_laser_link"/>
  <joint name="front_laser_joint" type="fixed">
    <parent link="base_link"/><child link="front_laser_link"/>
    <origin xyz="0.239 0.175 0.1455" rpy="0 0 0.7853981633974483"/>
  </joint>
  <!-- User-specified back lidar pose relative to base_link -->
  <link name="back_laser_link"/>
  <joint name="back_laser_joint" type="fixed">
    <parent link="base_link"/><child link="back_laser_link"/>
    <origin xyz="-0.239 -0.175 0.1455" rpy="0 0 -2.356194490192345"/>
  </joint>
</robot>
